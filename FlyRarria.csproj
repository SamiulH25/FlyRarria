<Project Sdk="Microsoft.NET.Sdk">
  <!-- Resolved by tModLoader when building from the Mods folder / workshop pipeline. -->
  <Import Project="..\tModLoader.targets" Condition="Exists('..\tModLoader.targets')" />
  <PropertyGroup>
    <AssemblyName>FlyRarria</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Circuits/*.json" />
  </ItemGroup>
</Project>
